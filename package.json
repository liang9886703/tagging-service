{
  "name": "tagging-service",
  "version": "0.1.0",
  "description": "Standalone intelligent tagging SDK and service",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.5.1",
  "files": [
    "dist",
    ".opencode/skills/intelligent-tagging/SKILL.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "tagging-service": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --experimental-strip-types src/cli.ts serve",
    "serve": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.41",
    "env-schema": "^6.1.0",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
